# Build directories
/build/
/build-*/
/out/
/cmake-build-*/

# CMake user presets (machine-specific)
CMakeUserPresets.json

# Compiler database
compile_commands.json

# mcpp (secondary build tool)
/target/
/.mcpp/

# Local tooling downloads (mcpp binary + sandbox, not part of the repo)
/.tools/

# Editors / IDEs
.vscode/
.idea/
.cache/
.DS_Store

# Python (tooling helpers)
__pycache__/
*.pyc

# Runtime artifacts (examples, benchmarks)
*.log

# Temporary sandbox deploy key (never commit)
.deploy_key
.deploy_key.pub
.known_hosts

# Packaging
*.tar.gz
*.zip
