# Minimal Doxygen configuration for quill. Generate with:
#   cmake --build . --target docs
# or: doxygen Doxyfile

PROJECT_NAME           = "quill"
PROJECT_NUMBER         = "0.1.0"
PROJECT_BRIEF          = "A lightweight, customizable, thread-safe C++20 logging library"

OUTPUT_DIRECTORY       = build/docs

INPUT                  = include
RECURSIVE              = YES
FILE_PATTERNS          = *.h

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
